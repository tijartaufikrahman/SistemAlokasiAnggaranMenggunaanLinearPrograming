@{
    ViewData["Title"] = "Verifikasi OTP";
    Layout = null;
    var email = (ViewData["Email"] as string) ?? "";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Verifikasi OTP - FinAlok</title>
    <!-- Bootstrap 5 CSS untuk Struktur Dasar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #f8fafc;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(56, 189, 248, 0.07) 0%, transparent 50%),
                radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.04) 0%, transparent 40%);
        }
        .card {
            width: 100%; max-width: 440px; background: #fff; border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px; border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .card { padding: 32px 20px 28px; border-radius: 16px; }
        }
        .header { text-align: center; margin-bottom: 24px; }
        .logo {
            width: 64px; height: 64px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border-radius: 16px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px; box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25);
            transform: rotate(-3deg); transition: transform .3s ease;
        }
        .logo:hover { transform: rotate(0deg) scale(1.05); }
        .logo i { font-size: 28px; color: #fff; }
        .header h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 4px; }
        .header p { color: #64748b; font-size: 13px; line-height: 1.5; }
        .email-badge {
            background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8;
            font-weight: 600; padding: 4px 12px; border-radius: 20px; display: inline-block; font-size: 12.5px;
            margin-top: 6px; word-break: break-all;
        }

        /* 6-Digit OTP Input Grid */
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 22px 0;
        }
        .otp-digit {
            width: 48px;
            height: 56px;
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            background: #f8fafc;
            color: #0f172a;
            outline: none;
            transition: all 0.2s ease;
            font-family: monospace;
        }
        @@media (max-width: 400px) {
            .otp-digit { width: 40px; height: 50px; font-size: 20px; gap: 6px; }
        }
        .otp-digit:focus {
            border-color: #2563eb;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
        }

        .btn {
            width: 100%; padding: 13px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 600;
            cursor: pointer; transition: all .25s; display: flex; align-items: center;
            justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        }
        .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4); }
        .btn:disabled { opacity: 0.7; cursor: not-allowed; }

        .error-msg {
            background: #fef2f2; color: #dc2626; padding: 11px 14px; border-radius: 10px;
            font-size: 13px; margin-bottom: 16px; border: 1px solid #fecaca;
            display: flex; align-items: center; gap: 8px;
        }
        .success-msg {
            background: #f0fdf4; color: #166534; padding: 11px 14px; border-radius: 10px;
            font-size: 13px; margin-bottom: 16px; border: 1px solid #bbf7d0;
            display: flex; align-items: center; gap: 8px;
        }

        .resend-box { text-align: center; margin-top: 20px; font-size: 13px; color: #64748b; }
        .resend-link { color: #2563eb; text-decoration: none; font-weight: 600; cursor: pointer; border: none; background: none; }
        .resend-link:hover { text-decoration: underline; color: #1d4ed8; }
        .back-link { text-align: center; margin-top: 14px; font-size: 12.5px; color: #64748b; }
        .back-link a { color: #64748b; text-decoration: none; }
        .back-link a:hover { color: #2563eb; text-decoration: underline; }
    </style>
</head>
<body>
    <!-- ATURAN 1: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-3 py-4 position-relative min-vh-100 d-flex align-items-center justify-content-center w-100">
        <div class="card">
            <div class="header">
                <div class="logo"><i class="fas fa-shield-halved"></i></div>
                <h1>Verifikasi Kode OTP</h1>
                <p>Masukkan 6 digit kode OTP yang telah kami kirimkan ke email Anda:</p>
                <div class="email-badge" id="displayEmail">@email</div>
            </div>

            <div id="alertArea"></div>

            <!-- ATURAN 2: Onsubmit di tag HTML memanggil fungsi JS -->
            <form id="formVerifyOtp" onsubmit="submitVerifyOtp(event)">
                <input type="hidden" id="hiddenEmail" value="@email" />

                <!-- 6 Kotak Digit OTP Interaktif -->
                <div class="otp-container">
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" autofocus />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                </div>

                <button type="submit" id="btnVerify" class="btn">
                    <i class="fas fa-check-circle"></i> Verifikasi OTP
                </button>
            </form>

            <div class="resend-box">
                Belum menerima kode? 
                <!-- ATURAN 2: Onclick di tag HTML memanggil fungsi JS -->
                <button type="button" class="resend-link" onclick="resendOtp()" id="btnResend">Kirim Ulang</button>
            </div>

            <div class="back-link">
                <a href="/Account/ForgotPassword"><i class="fas fa-arrow-left"></i> Ubah Email</a> &bull;
                <a href="/Account/Login">Kembali ke Login</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        // Ambil email dari query string atau session jika ada
        function getTargetEmail() {
            var urlParams = new URLSearchParams(window.location.search);
            var emailParam = urlParams.get('email');
            var hiddenEmail = $('#hiddenEmail').val();
            return (emailParam || hiddenEmail || '').trim();
        }

        // Ambil nilai gabungan 6 digit OTP via jQuery
        function getEnteredOtp() {
            var otpStr = '';
            $('.otp-digit').each(function () {
                otpStr += $(this).val().trim();
            });
            return otpStr;
        }

        // ATURAN 2: Handler submit form verifikasi OTP
        function submitVerifyOtp(e) {
            e.preventDefault();
            $('#alertArea').empty();

            var email = getTargetEmail();
            var otp = getEnteredOtp();

            if (!email) {
                showError('Email tidak valid. Silakan kembali ke halaman lupa password.');
                return;
            }

            if (otp.length < 6) {
                showError('Silakan masukkan 6 digit kode OTP secara lengkap.');
                return;
            }

            var $btn = $('#btnVerify');

            // ATURAN 2: Request via $.ajax() lengkap
            $.ajax({
                url: API_BASE_URL + '/auth/verify-otp',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    email: email,
                    otp: otp
                }),
                beforeSend: function () {
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memverifikasi...');
                },
                success: function (res) {
                    showSuccess('Kode OTP valid! Mengalihkan ke pembuatan password baru...');
                    setTimeout(function () {
                        // Redirect ke halaman Reset Password membawa parameter email dan OTP yang terverifikasi
                        window.location.href = '/Account/ResetPassword?email=' + encodeURIComponent(email) + '&otp=' + encodeURIComponent(otp);
                    }, 800);
                },
                error: function (xhr) {
                    var msg = 'Kode OTP tidak sesuai atau telah kedaluwarsa.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> Verifikasi OTP');
                }
            });
        }

        // ATURAN 2: Handler kirim ulang OTP
        function resendOtp() {
            var email = getTargetEmail();
            if (!email) {
                showError('Alamat email tidak ditemukan.');
                return;
            }

            var $btn = $('#btnResend');

            $.ajax({
                url: API_BASE_URL + '/auth/forgot-password',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({ email: email }),
                beforeSend: function () {
                    $btn.prop('disabled', true).text('Mengirim...');
                },
                success: function (res) {
                    showSuccess('Kode OTP baru telah dikirim ke email Anda!');
                    $('.otp-digit').val('');
                    $('.otp-digit').first().focus();
                },
                error: function (xhr) {
                    var msg = 'Gagal mengirim ulang OTP.';
                    if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                    showError(msg);
                },
                complete: function () {
                    $btn.prop('disabled', false).text('Kirim Ulang');
                }
            });
        }

        // ATURAN 2: Manipulasi 6-digit input OTP 100% menggunakan jQuery
        $(function () {
            var email = getTargetEmail();
            if (email) {
                $('#displayEmail').text(email);
            } else {
                $('#displayEmail').text('Email tidak terdeteksi');
            }

            var $digits = $('.otp-digit');

            $digits.on('input', function () {
                var val = $(this).val().replace(/[^0-9]/g, '');
                $(this).val(val);

                // Jika terisi 1 digit, pindah ke input berikutnya
                if (val.length >= 1) {
                    var $next = $(this).next('.otp-digit');
                    if ($next.length) {
                        $next.focus();
                    }
                }
            });

            // Mendukung tombol backspace untuk mundur otomatis
            $digits.on('keydown', function (e) {
                if (e.key === 'Backspace' && !$(this).val()) {
                    var $prev = $(this).prev('.otp-digit');
                    if ($prev.length) {
                        $prev.focus();
                    }
                }
            });

            // Mendukung paste teks 6 digit
            $digits.first().on('paste', function (e) {
                var pasted = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
                if (pasted && /^\d{6}$/.test(pasted.trim())) {
                    e.preventDefault();
                    var digitsArr = pasted.trim().split('');
                    $digits.each(function (i) {
                        $(this).val(digitsArr[i] || '');
                    });
                    $digits.last().focus();
                }
            });
        });
    </script>
</body>
</html>
