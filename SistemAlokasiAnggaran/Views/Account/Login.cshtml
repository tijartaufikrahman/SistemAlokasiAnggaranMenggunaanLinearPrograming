@{
    ViewData["Title"] = "Masuk";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Masuk - FinAlok</title>
    <script>
        // Deteksi dini autentikasi untuk mencegah kedip/flicker & loop riwayat Back browser
        (function fastAuthCheck() {
            var c = document.cookie.split("; ").find(function (row) { return row.startsWith("jwtToken="); });
            var cookieToken = c ? decodeURIComponent(c.split("=")[1]) : null;
            if (cookieToken) {
                var u = null;
                try { u = JSON.parse(localStorage.getItem('currentUser')); } catch (e) {}
                var target = (u && u.roleName === 'Admin') ? '/Admin/Dashboard' : '/Home/Index';
                window.location.replace(target);
            } else {
                try {
                    localStorage.removeItem('jwtToken');
                    localStorage.removeItem('currentUser');
                } catch(e) {}
            }
        })();
        window.addEventListener('pageshow', function (event) {
            var c = document.cookie.split("; ").find(function (row) { return row.startsWith("jwtToken="); });
            var cookieToken = c ? decodeURIComponent(c.split("=")[1]) : null;
            if (cookieToken) {
                var u = null;
                try { u = JSON.parse(localStorage.getItem('currentUser')); } catch (e) {}
                var target = (u && u.roleName === 'Admin') ? '/Admin/Dashboard' : '/Home/Index';
                window.location.replace(target);
            }
        });
    </script>
    <!-- Bootstrap 5 CSS untuk Struktur Dasar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #f8fafc;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(56, 189, 248, 0.07) 0%, transparent 50%),
                radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.04) 0%, transparent 40%);
        }
        .login-wrapper { width: 100%; max-width: 420px; position: relative; }
        .login-wrapper::before, .login-wrapper::after {
            content: ''; position: fixed; border-radius: 50%; opacity: 0.07; pointer-events: none; z-index: 0;
        }
        .login-wrapper::before { width: 300px; height: 300px; background: #2563eb; top: -80px; right: -100px; }
        .login-wrapper::after { width: 200px; height: 200px; background: #38bdf8; bottom: -60px; left: -80px; }
        .login-card {
            position: relative; z-index: 1; background: #ffffff; border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px; width: 100%; border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .login-card { padding: 32px 22px 28px; border-radius: 16px; }
        }
        .login-header { text-align: center; margin-bottom: 30px; }
        .login-header .logo {
            width: 68px; height: 68px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border-radius: 18px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 18px; box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25);
            transform: rotate(-3deg); transition: transform .3s ease;
        }
        .login-header .logo:hover { transform: rotate(0deg) scale(1.05); }
        .login-header .logo i { font-size: 30px; color: #fff; }
        .login-header h1 { font-size: 22px; color: #0f172a; margin-bottom: 4px; font-weight: 700; letter-spacing: -.02em; }
        .login-header p { color: #64748b; font-size: 13.5px; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 7px; }
        .input-wrapper { position: relative; }
        .input-wrapper i.fi { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 15px; transition: color .2s; }
        .input-wrapper:focus-within i.fi { color: #2563eb; }
        .toggle-pwd {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            color: #94a3b8; cursor: pointer; font-size: 15px; background: none; border: none; padding: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .toggle-pwd:hover { color: #2563eb; }
        .form-group input[type=email], .form-group input[type=password], .form-group input[type=text] {
            width: 100%; padding: 12px 40px 12px 42px; border: 1.5px solid #e2e8f0;
            border-radius: 12px; font-size: 14px; color: #1e293b; background: #f8fafc;
            transition: all .2s; outline: none;
        }
        .form-group input:focus { border-color: #2563eb; background: #fff; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
        .form-group input::placeholder { color: #94a3b8; }
        .form-check { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
        .form-check input { width: auto; padding: 0; accent-color: #2563eb; }
        .form-check label { font-size: 13px; color: #64748b; font-weight: 400; margin: 0; }
        .forgot-link { text-align: right; margin-bottom: 18px; }
        .forgot-link a { color: #2563eb; font-size: 12.5px; text-decoration: none; font-weight: 500; }
        .forgot-link a:hover { text-decoration: underline; color: #1d4ed8; }
        .btn-login {
            width: 100%; padding: 13px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white; border: none; border-radius: 12px; font-size: 15px; font-weight: 600;
            cursor: pointer; transition: all .25s; display: flex; align-items: center;
            justify-content: center; gap: 8px; margin-top: 4px;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        }
        .btn-login:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4); }
        .btn-login:active { transform: translateY(0); }
        .btn-login:disabled { opacity: 0.7; cursor: not-allowed; }
        .error-msg {
            background: #fef2f2; color: #dc2626; padding: 11px 14px;
            border-radius: 10px; font-size: 13px; margin-bottom: 16px;
            border: 1px solid #fecaca; display: flex; align-items: center; gap: 8px;
        }
        .success-msg {
            background: #f0fdf4; color: #166534; padding: 11px 14px;
            border-radius: 10px; font-size: 13px; margin-bottom: 16px;
            border: 1px solid #bbf7d0; display: flex; align-items: center; gap: 8px;
        }
        .login-footer { text-align: center; margin-top: 20px; font-size: 11.5px; color: #94a3b8; }
    </style>
</head>
<body>
    <!-- ATURAN 1: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-3 py-4 position-relative min-vh-100 d-flex align-items-center justify-content-center w-100">
        <div class="login-wrapper">
            <div class="login-card">
                <div class="login-header">
                    <div class="logo"><i class="fas fa-chart-pie"></i></div>
                    <h1>FinAlok</h1>
                    <p>Sistem Alokasi Anggaran</p>
                </div>

                <div id="alertArea"></div>

                <!-- ATURAN 2: Onsubmit di tag HTML memanggil fungsi JS -->
                <form id="formLogin" onsubmit="submitLogin(event)">
                    <div class="form-group">
                        <label for="emailInput">Email</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope fi"></i>
                            <input id="emailInput" type="email" placeholder="Masukkan email terdaftar" autocomplete="email" value="admin@example.com" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="pwdInput">Kata Sandi</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock fi"></i>
                            <input id="pwdInput" type="password" placeholder="Masukkan kata sandi" autocomplete="current-password" value="123" required />
                            <!-- ATURAN 2: Onclick di tag HTML memanggil fungsi JS -->
                            <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('pwdInput', this)" title="Tampilkan kata sandi">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
                        <div class="form-check">
                            <input type="checkbox" id="rememberMe" />
                            <label for="rememberMe">Ingat saya</label>
                        </div>
                        <div class="forgot-link" style="margin:0;">
                            <a href="/Account/ForgotPassword">Lupa password?</a>
                        </div>
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-login">
                        <i class="fas fa-arrow-right-to-bracket"></i> Masuk
                    </button>

                    <div class="login-footer">FinAlok &copy; 2026</div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        // Pastikan AuthSession dan fungsi token siap dan kebal cache browser
        window.AuthSession = window.AuthSession || {};
        if (typeof window.AuthSession.setToken !== 'function') {
            window.AuthSession.setToken = function (token) {
                if (!token) return;
                localStorage.setItem('jwtToken', token);
                var d = new Date(); d.setTime(d.getTime() + 24 * 60 * 60 * 1000);
                document.cookie = "jwtToken=" + encodeURIComponent(token) + ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax";
            };
        }
        if (typeof window.AuthSession.getToken !== 'function') {
            window.AuthSession.getToken = function () {
                var c = document.cookie.split("; ").find(function (row) { return row.startsWith("jwtToken="); });
                var cookieToken = c ? decodeURIComponent(c.split("=")[1]) : null;
                // Jika cookie jwtToken sudah tidak ada (misal setelah logout), bersihkan localStorage agar tidak loop
                if (!cookieToken) {
                    try {
                        localStorage.removeItem('jwtToken');
                        localStorage.removeItem('currentUser');
                    } catch (e) {}
                    return null;
                }
                return cookieToken;
            };
        }
        if (typeof window.AuthSession.setUser !== 'function') {
            window.AuthSession.setUser = function (user) {
                if (!user) return;
                localStorage.setItem('currentUser', JSON.stringify(user));
                if (user.namaLengkap) {
                    var d = new Date(); d.setTime(d.getTime() + 24 * 60 * 60 * 1000);
                    document.cookie = "userName=" + encodeURIComponent(user.namaLengkap) + ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax";
                }
                if (user.roleName) {
                    var d = new Date(); d.setTime(d.getTime() + 24 * 60 * 60 * 1000);
                    document.cookie = "userRole=" + encodeURIComponent(user.roleName) + ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax";
                }
            };
        }
        if (typeof window.AuthSession.getUser !== 'function') {
            window.AuthSession.getUser = function () {
                try {
                    var data = localStorage.getItem('currentUser');
                    return data ? JSON.parse(data) : null;
                } catch (e) { return null; }
            };
        }
        if (typeof window.AuthSession.isAuthenticated !== 'function') {
            window.AuthSession.isAuthenticated = function () {
                var token = window.AuthSession.getToken();
                var user = window.AuthSession.getUser();
                return !!(token && user);
            };
        }

        // Cek login dan lakukan redirect dengan REPLACE agar tidak masuk ke history Back browser
        function redirectIfLoggedIn() {
            if (window.AuthSession && typeof window.AuthSession.isAuthenticated === 'function' && window.AuthSession.isAuthenticated()) {
                var current = window.AuthSession.getUser();
                var target = (current && current.roleName === 'Admin') ? '/Admin/Dashboard' : '/Home/Index';
                window.location.replace(target);
                return true;
            }
            return false;
        }

        // Eksekusi segera
        redirectIfLoggedIn();

        // ATURAN 2: Manipulasi DOM 100% menggunakan jQuery $('...'), DILARANG Vanilla DOM
        function togglePasswordVisibility(id, btn) {
            var $input = $('#' + id);
            var $icon = $(btn).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.attr('class', 'fas fa-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.attr('class', 'fas fa-eye');
            }
        }

        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        // ATURAN 2: Handler form login dipanggil langsung dari atribut onsubmit
        function submitLogin(e) {
            e.preventDefault();
            $('#alertArea').empty();
            var $btn = $('#btnSubmit');

            var email = $('#emailInput').val().trim();
            var password = $('#pwdInput').val();
            var rememberMe = $('#rememberMe').is(':checked');

            if (!email || !password) {
                showError('Email dan kata sandi wajib diisi.');
                return;
            }

            // ATURAN 2: Request Ajax jQuery wajib struktur lengkap $.ajax() (DILARANG $.get / $.post)
            $.ajax({
                url: API_BASE_URL + '/auth/login',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    email: email,
                    password: password,
                    rememberMe: rememberMe
                }),
                beforeSend: function () {
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memverifikasi...');
                },
                success: function (res) {
                    if (res.success && res.user) {
                        showSuccess('Login berhasil! Mengalihkan...');
                        // Simpan token JWT dan user session (aman dari cache lama)
                        if (window.AuthSession && typeof window.AuthSession.setToken === 'function') {
                            window.AuthSession.setToken(res.token);
                        } else if (res.token) {
                            localStorage.setItem('jwtToken', res.token);
                        }
                        if (window.AuthSession && typeof window.AuthSession.setUser === 'function') {
                            window.AuthSession.setUser(res.user);
                        } else if (res.user) {
                            localStorage.setItem('currentUser', JSON.stringify(res.user));
                        }

                        setTimeout(function () {
                            var target = (res.user.roleName === 'Admin') ? '/Admin/Dashboard' : '/Home/Index';
                            // Gunakan location.replace agar halaman login tidak menumpuk di riwayat Back browser
                            window.location.replace(target);
                        }, 350);
                    } else {
                        showError(res.message || 'Login gagal.');
                        $btn.prop('disabled', false).html('<i class="fas fa-arrow-right-to-bracket"></i> Masuk');
                    }
                },
                error: function (xhr) {
                    var msg = 'Email atau kata sandi tidak sesuai. Silakan periksa kembali.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-arrow-right-to-bracket"></i> Masuk');
                }
            });
        }

        $(function () {
            redirectIfLoggedIn();
        });

        // Tangkal pemulihan snapshot dari BFCache saat tombol Back ditekan
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                redirectIfLoggedIn();
            }
        });
    </script>
</body>
</html>
