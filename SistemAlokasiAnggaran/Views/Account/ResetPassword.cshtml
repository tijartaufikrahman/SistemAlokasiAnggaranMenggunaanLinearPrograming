@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
    var token = (ViewData["Token"] as string) ?? "";
    var email = (ViewData["Email"] as string) ?? "";
    var otp = (ViewData["Otp"] as string) ?? "";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Reset Password - FinAlok</title>
    <!-- Bootstrap 5 CSS untuk Struktur Dasar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            background: #f8fafc;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(56, 189, 248, 0.07) 0%, transparent 50%),
                radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.04) 0%, transparent 40%);
        }
        .card {
            width: 100%; max-width: 420px; background: #fff; border-radius: 20px;
            box-shadow: 0 10px 40px rgba(15,23,42,.08); padding: 44px 36px 36px;
            border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .card { padding: 32px 22px 28px; border-radius: 16px; }
        }
        .header { text-align: center; margin-bottom: 26px; }
        .logo {
            width: 64px; height: 64px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border-radius: 16px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px; box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25);
            transform: rotate(-3deg); transition: transform .3s ease;
        }
        .logo:hover { transform: rotate(0deg) scale(1.05); }
        .logo i { font-size: 28px; color: #fff; }
        .header h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 4px; }
        .header p { color: #64748b; font-size: 13px; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 7px; }
        .input-wrapper { position: relative; }
        .input-wrapper i.fi { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 15px; }
        .input-wrapper:focus-within i.fi { color: #2563eb; }
        .toggle-pwd {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            color: #94a3b8; cursor: pointer; font-size: 15px; background: none; border: none; padding: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .toggle-pwd:hover { color: #2563eb; }
        .form-group input {
            width: 100%; padding: 12px 40px 12px 42px; border: 1.5px solid #e2e8f0;
            border-radius: 12px; font-size: 14px; color: #1e293b; background: #f8fafc; outline: none; transition: all .2s;
        }
        .form-group input:focus { border-color: #2563eb; background: #fff; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
        .btn {
            width: 100%; padding: 13px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 600;
            cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3); transition: all .25s;
        }
        .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4); }
        .btn:disabled { opacity: 0.7; cursor: not-allowed; }
        .error-msg {
            background: #fef2f2; color: #dc2626; padding: 11px 14px; border-radius: 10px;
            font-size: 13px; margin-bottom: 16px; border: 1px solid #fecaca;
            display: flex; align-items: center; gap: 8px;
        }
        .success-msg {
            background: #f0fdf4; color: #166534; padding: 11px 14px; border-radius: 10px;
            font-size: 13px; margin-bottom: 16px; border: 1px solid #bbf7d0;
            display: flex; align-items: center; gap: 8px;
        }
        .pw-hint { font-size: 11.5px; color: #94a3b8; margin-top: 6px; }
        .back-link { text-align: center; margin-top: 20px; font-size: 13px; }
        .back-link a { color: #2563eb; text-decoration: none; font-weight: 500; }
        .back-link a:hover { text-decoration: underline; color: #1d4ed8; }
    </style>
</head>
<body>
    <!-- ATURAN 1: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-3 py-4 position-relative min-vh-100 d-flex align-items-center justify-content-center w-100">
        <div class="card">
            <div class="header">
                <div class="logo"><i class="fas fa-lock-open"></i></div>
                <h1>Buat Password Baru</h1>
                <p>Masukkan password baru Anda untuk mengamankan akun FinAlok.</p>
            </div>

            <div id="alertArea"></div>

            <!-- ATURAN 2: Onsubmit di tag HTML memanggil fungsi JS -->
            <form id="formResetPassword" onsubmit="submitResetPassword(event)">
                <input type="hidden" id="resetEmail" value="@email" />
                <input type="hidden" id="resetOtp" value="@otp" />
                <input type="hidden" id="resetToken" value="@token" />

                <div class="form-group">
                    <label for="newPwd">Password Baru</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock fi"></i>
                        <input type="password" id="newPwd" placeholder="Minimal 6 karakter" required minlength="6" autocomplete="new-password" />
                        <!-- ATURAN 2: Onclick di tag HTML memanggil fungsi JS -->
                        <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('newPwd', this)" title="Tampilkan password">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="pw-hint">Kombinasi minimal 6 karakter</div>
                </div>

                <div class="form-group">
                    <label for="confPwd">Konfirmasi Password Baru</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock fi"></i>
                        <input type="password" id="confPwd" placeholder="Ulangi password baru" required minlength="6" autocomplete="new-password" />
                        <!-- ATURAN 2: Onclick di tag HTML memanggil fungsi JS -->
                        <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('confPwd', this)" title="Tampilkan password">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" id="btnSubmit" class="btn">
                    <i class="fas fa-check"></i> Simpan Password Baru
                </button>
            </form>

            <div class="back-link">
                <a href="/Account/Login"><i class="fas fa-arrow-left"></i> Kembali ke Login</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        // ATURAN 2: Manipulasi DOM 100% menggunakan jQuery $('...'), DILARANG Vanilla DOM
        function togglePasswordVisibility(id, btn) {
            var $input = $('#' + id);
            var $icon = $(btn).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.attr('class', 'fas fa-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.attr('class', 'fas fa-eye');
            }
        }

        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        // ATURAN 2: Handler submit form reset password
        function submitResetPassword(e) {
            e.preventDefault();
            $('#alertArea').empty();

            var urlParams = new URLSearchParams(window.location.search);
            var email = $('#resetEmail').val() || urlParams.get('email') || '';
            var otp = $('#resetOtp').val() || urlParams.get('otp') || '';
            var token = $('#resetToken').val() || urlParams.get('token') || '';

            var newPassword = $('#newPwd').val();
            var confirmPassword = $('#confPwd').val();

            if (newPassword.length < 6) {
                showError('Password minimal 6 karakter.');
                return;
            }

            if (newPassword !== confirmPassword) {
                showError('Password dan konfirmasi password tidak cocok.');
                return;
            }

            var $btn = $('#btnSubmit');

            // Payload fleksibel: mendukung verifikasi OTP (email + otp) maupun Token URL
            var payload = {
                email: email,
                otp: otp,
                token: token,
                newPassword: newPassword,
                confirmPassword: confirmPassword
            };

            // ATURAN 2: Request via $.ajax() lengkap (DILARANG $.get / $.post)
            $.ajax({
                url: API_BASE_URL + '/auth/reset-password',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify(payload),
                beforeSend: function () {
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan password baru...');
                },
                success: function (res) {
                    showSuccess('Password berhasil diubah! Mengalihkan ke halaman login...');
                    setTimeout(function () {
                        window.location.replace('/Account/Login');
                    }, 1200);
                },
                error: function (xhr) {
                    var msg = 'Gagal mereset password. Pastikan kode verifikasi Anda masih berlaku.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-check"></i> Simpan Password Baru');
                }
            });
        }

        $(function () {
            var urlParams = new URLSearchParams(window.location.search);
            var email = $('#resetEmail').val() || urlParams.get('email');
            var otp = $('#resetOtp').val() || urlParams.get('otp');
            var token = $('#resetToken').val() || urlParams.get('token');

            // Jika ada parameter, simpan ke hidden input
            if (email) $('#resetEmail').val(email);
            if (otp) $('#resetOtp').val(otp);
            if (token) $('#resetToken').val(token);

            // Validasi keberadaan data verifikasi
            if (!token && (!email || !otp)) {
                showError('Data verifikasi reset password tidak ditemukan. Silakan mulai kembali dari halaman lupa password.');
                $('#btnSubmit').prop('disabled', true);
            }
        });
    </script>
</body>
</html>
