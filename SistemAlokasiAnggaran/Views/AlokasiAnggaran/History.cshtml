@{
    ViewData["Title"] = "History Anggaran";
}

@* ATURAN STYLING: Blok <style> WAJIB di bagian ATAS file konten *@
<style>
    /* DataTable Overrides & History UI */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 1rem;
    }
    .dataTables_wrapper .dataTables_length select {
        border-radius: 6px;
        padding: 6px 10px;
        border: 1px solid #e2e8f0;
        outline: none;
        background: #ffffff;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_length select:focus {
        border-color: #2563eb;
    }
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 6px;
        padding: 6px 12px;
        border: 1px solid #cbd5e1;
        margin-left: 6px;
        outline: none;
        transition: all 0.15s;
        background: #ffffff;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }
    .dataTables_wrapper .dataTables_info {
        font-size: 0.82rem;
        color: #64748b;
        padding-top: 0.85rem;
    }
    .dataTables_wrapper .dataTables_paginate {
        padding-top: 0.75rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 0.35rem 0.75rem !important;
        margin: 0 2px !important;
        border-radius: 6px !important;
        font-size: 0.85rem !important;
        border: 1px solid #e2e8f0 !important;
        background: #ffffff !important;
        color: #334155 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f8fafc !important;
        color: #0f172a !important;
        border-color: #cbd5e1 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: #2563eb !important;
        color: #ffffff !important;
        border-color: #2563eb !important;
        box-shadow: 0 1px 2px rgba(37, 99, 235, 0.3) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        color: #cbd5e1 !important;
        border-color: #f1f5f9 !important;
        background: #f8fafc !important;
    }
    .table-data { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .table-data thead th {
        background: #f8fafc;
        color: #64748b;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 11px 16px;
        border-bottom: 1px solid #e2e8f0;
    }
    .table-data tbody tr:hover td { background: #f8fafc !important; }
    .table-data td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; color: #0f172a; vertical-align: middle; background: #ffffff; }
    .badge-status { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: var(--radius-pill, 9999px); font-size: 0.75rem; font-weight: 600; }
    .badge-optimal { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .badge-nosol { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .btn-detail { display: inline-flex; align-items: center; gap: 5px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 5px 11px; font-size: 0.78rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: all .15s; }
    .btn-detail:hover { background: #2563eb; color: #fff; border-color: #2563eb; }
    .btn-edit-hist { display: inline-flex; align-items: center; gap: 5px; background: #fffbeb; color: #b45309; border: 1px solid #fde68a; border-radius: 6px; padding: 5px 11px; font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all .15s; }
    .btn-edit-hist:hover { background: #b45309; color: #fff; border-color: #b45309; }
    .btn-delete-hist { display: inline-flex; align-items: center; gap: 5px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 6px; padding: 5px 11px; font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all .15s; }
    .btn-delete-hist:hover { background: #dc2626; color: #fff; border-color: #dc2626; }
</style>

<!-- ATURAN STYLING: Pembungkus konten WAJIB diawali <div class="row ..."> -->
<div class="row">
    <div class="col-12">
        <!-- Card Filter Tanggal Dokumen -->
        <div class="card mb-4">
            <div class="card-header">
                <h3>Filter Dokumen</h3>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label" for="filterTglAwal">Tanggal Awal</label>
                        <input type="date" id="filterTglAwal" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="filterTglAkhir">Tanggal Akhir</label>
                        <input type="date" id="filterTglAkhir" class="form-control" />
                    </div>
                    <div class="col-md-4" style="display:flex;gap:.5rem;">
                        <button type="button" class="btn btn-primary" id="btnApplyFilter" onclick="applyFilter()" style="flex:1;">
                            <i class="fas fa-filter"></i> Filter
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="btnResetFilter" onclick="resetFilter()" style="flex:1;">
                            <i class="fas fa-rotate-left"></i> Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Riwayat Alokasi Anggaran -->
        <div class="card">
            <div class="card-header">
                <h3>Riwayat Alokasi Anggaran</h3>
            </div>
            <div class="card-body">
                <!-- Table dengan DataTable -->
                <div class="table-responsive">
                    <table id="historyTable" class="table table-striped table-hover table-data w-100">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:50px;">No</th>
                                <th>Catatan / Keterangan</th>
                                <th class="text-end">Total Dana</th>
                                <th>Tanggal Proses</th>
                                <th class="text-end" style="width:170px;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var dtHistory = null;
    var getCsrfToken = function () {
        return $('meta[name="csrf-token"]').attr('content') || '';
    };

    function formatRp(val) {
        if (val === null || val === undefined) return '-';
        return 'Rp' + Number(val).toLocaleString('id-ID');
    }

    function formatDate(isoStr) {
        if (!isoStr) return '-';
        var dt = new Date(isoStr);
        return dt.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function escHtml(str) {
        return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // ATURAN DATATABLES: Inisialisasi DataTable Bahasa Indonesia & pagination panah
    function initDataTable() {
        dtHistory = $('#historyTable').DataTable({
            pageLength: 10,
            lengthMenu: [
                [10, 25, 50, 100, -1],
                [10, 25, 50, 100, "Semua"]
            ],
            language: {
                lengthMenu: "Tampilkan _MENU_ data per halaman",
                zeroRecords: "Data tidak ditemukan",
                info: "Menampilkan _START_ sampai _END_ dari _TOTAL_ total data",
                infoEmpty: "Menampilkan 0 sampai 0 dari 0 data",
                infoFiltered: "(difilter dari _MAX_ total data)",
                search: "Cari:",
                searchPlaceholder: "Ketik kata kunci...",
                paginate: {
                    first: "«",
                    last: "»",
                    next: "›",
                    previous: "‹"
                },
                processing: "Sedang memproses data...",
                loadingRecords: "Memuat data..."
            },
            columns: [
                { data: null, render: function (d, t, r, m) { return m.row + 1; }, className: "text-center" },
                { data: 'catatan', render: function (d) { return d ? '<strong>' + escHtml(d) + '</strong>' : '<span class="text-muted">-</span>'; } },
                { data: 'totalDana', render: function (d) { return formatRp(d); }, className: "text-end" },
                { data: 'tanggalProses', render: function (d) { return formatDate(d); } },
                {
                    data: null,
                    orderable: false,
                    className: "text-end",
                    render: function (d, t, item) {
                        return '<div style="display:flex;gap:.35rem;justify-content:flex-end;">' +
                            '<a href="/AlokasiAnggaran/Detail/' + item.id + '" class="btn-detail" title="Lihat Detail"><i class="fas fa-eye"></i> Detail</a>' +
                            '<button type="button" class="btn-delete-hist" onclick="deleteHistory(' + item.id + ')" title="Hapus History"><i class="fas fa-trash-alt"></i> Hapus</button>' +
                            '</div>';
                    }
                }
            ]
        });
    }

    function getTodayWib() {
        try {
            return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date());
        } catch (e) {
            var now = new Date();
            var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            var wibDate = new Date(utc + (3600000 * 7));
            var year = wibDate.getFullYear();
            var month = String(wibDate.getMonth() + 1).padStart(2, '0');
            var day = String(wibDate.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }
    }

    function initFilterDates() {
        var today = getTodayWib();
        $('#filterTglAwal').val(today);
        $('#filterTglAkhir').val(today);
    }

    // ATURAN REQUEST: Menggunakan struktur lengkap $.ajax()
    function loadHistory() {
        var startDate = $('#filterTglAwal').val();
        var endDate = $('#filterTglAkhir').val();

        var queryParams = {};
        if (startDate) queryParams.startDate = startDate;
        if (endDate) queryParams.endDate = endDate;

        $.ajax({
            url: '/AlokasiAnggaran/GetHistory',
            type: 'GET',
            data: queryParams,
            dataType: 'json',
            success: function (data) {
                if (dtHistory) {
                    dtHistory.clear().rows.add(data || []).draw();
                }
            },
            error: function (xhr, status, error) {
                console.error('Gagal memuat history:', error);
            }
        });
    }

    function applyFilter() {
        loadHistory();
    }

    function resetFilter() {
        initFilterDates();
        loadHistory();
    }

    function deleteHistory(id) {
        if (!confirm('Apakah Anda yakin ingin menghapus history alokasi anggaran ini?')) return;

        $.ajax({
            url: '/AlokasiAnggaran/DeleteAllocation',
            type: 'POST',
            contentType: 'application/json',
            dataType: 'json',
            headers: { 'RequestVerificationToken': getCsrfToken() },
            data: JSON.stringify({ id: id }),
            success: function (d) {
                if (!d.success) {
                    alert(d.message);
                    return;
                }
                loadHistory();
            },
            error: function () {
                alert('Gagal menghapus history.');
            }
        });
    }

    $(function () {
        initDataTable();
        initFilterDates();
        loadHistory();
    });
</script>
}
