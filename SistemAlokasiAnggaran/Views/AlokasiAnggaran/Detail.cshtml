@model SistemAlokasiAnggaran.Models.ViewModels.DetailHistoryViewModel
@{
    ViewData["Title"] = "Detail History" + (!string.IsNullOrWhiteSpace(Model.Catatan) ? " - " + Model.Catatan : "");
}

@* ATURAN STYLING: Blok <style> WAJIB di bagian ATAS file konten *@
<style>
    .btn-back { display: inline-flex; align-items: center; gap: .5rem; background: #ffffff; color: var(--text-body, #3d3d5c); border: 1px solid var(--border-color, #e8eaf0); border-radius: var(--radius-md, 10px); padding: .55rem 1.2rem; font-size: .84rem; font-weight: 600; text-decoration: none; transition: all .15s; font-family: inherit; box-shadow: var(--shadow-xs); }
    .btn-back:hover { background: var(--bg-subtle, #f1f3f8); color: var(--text-main, #0f0e1a); border-color: var(--border-strong, #d1d5e8); }
    .btn-print { display: inline-flex; align-items: center; gap: .5rem; background: #ffffff; color: var(--primary, #7c3aed); border: 1px solid var(--primary-border, #c4b5fd); border-radius: var(--radius-md, 10px); padding: .55rem 1.2rem; font-size: .84rem; font-weight: 600; cursor: pointer; transition: all .15s; font-family: inherit; box-shadow: var(--shadow-xs); }
    .btn-print:hover { background: var(--primary-50, #f5f3ff); border-color: var(--primary, #7c3aed); }
    .btn-edit-hist { display: inline-flex; align-items: center; gap: .5rem; background: #fffbeb; color: #b45309; border: 1px solid #fde68a; border-radius: var(--radius-md, 10px); padding: .55rem 1.2rem; font-size: .84rem; font-weight: 600; cursor: pointer; transition: all .15s; font-family: inherit; box-shadow: var(--shadow-xs); }
    .btn-edit-hist:hover { background: #fef3c7; color: #78350f; border-color: #b45309; }
    .btn-delete-hist { display: inline-flex; align-items: center; gap: .5rem; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: var(--radius-md, 10px); padding: .55rem 1.1rem; font-size: .84rem; font-weight: 600; cursor: pointer; transition: all .15s; font-family: inherit; box-shadow: var(--shadow-xs); }
    .btn-delete-hist:hover { background: #fee2e2; border-color: #dc2626; }
    
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: .25rem .75rem;
        border-radius: var(--radius-pill, 9999px);
        font-size: .75rem;
        font-weight: 700;
    }
    .badge-optimal { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .badge-nosol { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    
    /* Full-Width Table */
    .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .table-data { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .table-data thead th {
        background: var(--bg-muted, #f8f9fc);
        color: var(--text-muted, #6b6b8d);
        font-weight: 700;
        font-size: .72rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-color, #e8eaf0);
        white-space: nowrap;
    }
    .table-data td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-subtle, #f1f3f8);
        color: var(--text-main, #0f0e1a);
        vertical-align: middle;
        background: #ffffff;
        font-variant-numeric: tabular-nums;
    }
    .table-data tr.total-row td {
        background: var(--bg-muted, #f8f9fc);
        border-top: 2px solid var(--border-color, #e8eaf0);
        border-bottom: none;
        font-weight: 700;
    }
    .table-data tr:hover td { background: #fcfdfe; }
    .result-col { background: #f5f3ff !important; color: var(--primary, #7c3aed); font-weight: 800; }
    
    .badge-prioritas {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.65rem;
        height: 1.65rem;
        border-radius: 50%;
        font-size: .78rem;
        font-weight: 700;
        text-align: center;
    }
    .badge-prioritas.p1 { background: #fef2f2; color: #b91c1c; border: 1.5px solid #fecaca; }
    .badge-prioritas.p2 { background: #fffbeb; color: #b45309; border: 1.5px solid #fde68a; }
    .badge-prioritas.p3 { background: #fefce8; color: #a16207; border: 1.5px solid #fef08a; }
    .badge-prioritas.p4 { background: #f0fdfa; color: #0f766e; border: 1.5px solid #99f6e4; }
    .badge-prioritas.p5 { background: #f5f3ff; color: #7c3aed; border: 1.5px solid #c4b5fd; }

    @@media print {
        .sidebar, .topbar, .btn-back, .btn-print, .btn-edit-hist, .btn-delete-hist, .breadcrumb-bar { display: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .card { box-shadow: none !important; border: 1px solid #e8eaf0 !important; }
    }
</style>

<!-- ATURAN STYLING: Pembungkus konten diawali <div class="row ..."> -->
<div class="row">
    <div class="col-12">
        <!-- Action Bar: Tombol Navigasi & Aksi -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:.75rem;">
            <a href="/AlokasiAnggaran/History" class="btn-back">
                <i class="fas fa-arrow-left"></i> Kembali ke Riwayat
            </a>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                <button type="button" class="btn-print" onclick="window.print()">
                    <i class="fas fa-print"></i> Cetak Dokumen
                </button>
                <button type="button" class="btn-edit-hist" onclick="editHistory(@Model.Id)">
                    <i class="fas fa-edit"></i> Edit & Hitung Ulang
                </button>
                <button type="button" class="btn-delete-hist" onclick="deleteHistory(@Model.Id)">
                    <i class="fas fa-trash-alt"></i> Hapus
                </button>
            </div>
        </div>

        @{
            var totalAlokasi = Model.Programs?.Sum(p => p.AlokasiOptimal) ?? 0m;
            var sisaDana = Math.Max(0, Model.TotalDana - totalAlokasi);
            var penyerapan = Model.TotalDana > 0 ? Math.Min(100, (totalAlokasi / Model.TotalDana) * 100).ToString("F1") : "0";
        }

        <!-- ========= RINGKASAN DOKUMEN RAMPING (COMPACT DOCUMENT STRIP) ========= -->
        <div class="card mb-3" style="border: 1px solid var(--border-color, #e8eaf0); border-radius: var(--radius-md, 12px); background: #ffffff; box-shadow: var(--shadow-xs);">
            <div class="card-body" style="padding: 0.95rem 1.4rem;">
                <div class="row align-items-center g-3">
                    <!-- Kolom 1: Catatan & Waktu -->
                    <div class="col-xl-5 col-lg-5 col-md-12">
                        <div style="min-width: 0;">
                            <div style="font-size: 0.72rem; color: var(--text-muted, #6b6b8d); margin-bottom: 3px; font-weight: 600;">
                                @Model.TanggalProses.ToString("dd MMM yyyy HH:mm") WIB
                            </div>
                            <div style="font-size: 0.95rem; font-weight: 700; color: var(--text-main, #0f0e1a); line-height: 1.35; word-break: break-word;">
                                @(string.IsNullOrWhiteSpace(Model.Catatan) ? "Rincian Alokasi Anggaran" : Model.Catatan)
                            </div>
                        </div>
                    </div>

                    <!-- Kolom 2: Total Pagu Anggaran -->
                    <div class="col-xl-2 col-lg-2 col-sm-4 col-6">
                        <div style="border-left: 2px solid var(--border-color, #e8eaf0); padding-left: 14px;">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #6b6b8d); display: block;">
                                Total Pagu Anggaran
                            </span>
                            <span style="font-size: 1.05rem; font-weight: 800; color: var(--text-main, #0f0e1a); white-space: nowrap;">
                                @Model.TotalDana.ToRupiah()
                            </span>
                        </div>
                    </div>

                    <!-- Kolom 3: Total Dialokasikan -->
                    <div class="col-xl-3 col-lg-3 col-sm-4 col-6">
                        <div style="border-left: 2px solid var(--border-color, #e8eaf0); padding-left: 14px;">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #6b6b8d); display: block;">
                                Total Dialokasikan
                            </span>
                            <span style="font-size: 1.05rem; font-weight: 800; color: #059669; white-space: nowrap;">
                                @totalAlokasi.ToRupiah()
                            </span>
                        </div>
                    </div>

                    <!-- Kolom 4: Ditetapkan Oleh -->
                    <div class="col-xl-2 col-lg-2 col-sm-4 col-12">
                        <div style="border-left: 2px solid var(--border-color, #e8eaf0); padding-left: 14px;">
                            <span style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #6b6b8d); display: block;">
                                Ditetapkan Oleh
                            </span>
                            <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-main, #0f0e1a); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;" title="@Model.NamaUser">
                                @Model.NamaUser
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========= CARD TABEL HASIL ALOKASI (FULL WIDTH COL-12) ========= -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header" style="display:flex; align-items:center; justify-content:space-between; padding:1.1rem 1.4rem;">
                        <div>
                            <h3 style="margin:0 0 2px 0; font-size:1rem; font-weight:800; color:var(--text-main,#0f0e1a);">
                                Rincian Usulan & Keputusan Alokasi Anggaran
                            </h3>
                            <p style="margin:0; font-size:0.8rem; color:var(--text-muted,#6b6b8d);">
                                Daftar program kegiatan yang dialokasikan.
                            </p>
                        </div>
                        <div>
                            <span style="font-size:0.82rem; font-weight:700; color:#475569; background:#f1f5f9; padding:4px 14px; border-radius:9999px; border:1px solid #cbd5e1; display:inline-flex; align-items:center;">
                                @(Model.Programs?.Count ?? 0) Program Kegiatan
                            </span>
                        </div>
                    </div>
                    <div class="card-body" style="padding:0.75rem 1rem 1rem;">
                        @if (Model.Programs != null && Model.Programs.Any())
                        {
                            <div class="table-responsive" style="border:1px solid var(--border-color,#e8eaf0); border-radius:10px; overflow-x:auto;">
                                <table class="table-data">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width:3.5rem;">No</th>
                                            <th>Nama Program Kegiatan</th>
                                            <th class="text-center" style="width:145px;">Anggaran Diajukan</th>
                                            <th class="text-center" style="width:135px;">Batas Min</th>
                                            <th class="text-center" style="width:135px;">Batas Maks</th>
                                            <th class="text-center" style="width:75px;">Prioritas</th>
                                            <th class="text-center" style="width:75px;">Skor Manfaat</th>
                                            <th class="text-center result-col" style="width:150px;">Alokasi Anggaran</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Programs.Count; i++)
                                        {
                                            var p = Model.Programs[i];
                                            <tr>
                                                <td class="text-center">@(i + 1)</td>
                                                <td><strong>@p.NamaProgram</strong></td>
                                                <td class="text-center">@p.AnggaranDiajukan.ToRupiah()</td>
                                                <td class="text-center">@p.AnggaranMinimum.ToRupiah()</td>
                                                <td class="text-center">@p.AnggaranMaksimum.ToRupiah()</td>
                                                <td class="text-center">
                                                    <span class="badge-prioritas p@(p.TingkatPrioritas)" title="Prioritas @p.TingkatPrioritas">@p.TingkatPrioritas</span>
                                                </td>
                                                <td class="text-center">@p.EstimasiManfaat</td>
                                                <td class="text-center result-col">@p.AlokasiOptimal.ToRupiah()</td>
                                            </tr>
                                        }
                                        <tr class="total-row">
                                            <td colspan="7" class="text-end" style="font-weight:700; color:var(--text-main,#0f0e1a); font-size:.92rem; padding-right:1.5rem;">
                                                Total Dana Dialokasikan
                                            </td>
                                            <td class="text-center result-col" style="font-size:1.05rem; font-weight:800; color:#7c3aed;">
                                                @totalAlokasi.ToRupiah()
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div style="text-align:center; padding:3rem 1.5rem; color:var(--text-muted,#6b6b8d);">
                                <i class="fas fa-folder-open" style="font-size:2.5rem; color:var(--text-light,#9ca3c0); margin-bottom:12px;"></i>
                                <p style="margin:0; font-size:0.9rem;">Tidak ada data program pada sesi alokasi ini.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var getCsrfToken = function () {
        return $('meta[name="csrf-token"]').attr('content') || '';
    };

    // ATURAN REQUEST: Handler submit/aksi dipanggil via event onclick HTML & memakai $.ajax() lengkap
    function editHistory(id) {
        if (!confirm('Edit alokasi ini? Status akan dikembalikan ke Draft agar bisa di-edit dan dihitung ulang.')) return;

        $.ajax({
            url: '/AlokasiAnggaran/ReopenDraft',
            type: 'POST',
            contentType: 'application/json',
            dataType: 'json',
            headers: { 'RequestVerificationToken': getCsrfToken() },
            data: JSON.stringify({ id: id }),
            success: function (d) {
                if (d.success) {
                    window.location.href = d.redirectUrl || '/AlokasiAnggaran/Index';
                } else {
                    alert(d.message);
                }
            },
            error: function () {
                alert('Gagal memproses alokasi.');
            }
        });
    }

    function deleteHistory(id) {
        if (!confirm('Apakah Anda yakin ingin menghapus history alokasi anggaran ini?')) return;

        $.ajax({
            url: '/AlokasiAnggaran/DeleteAllocation',
            type: 'POST',
            contentType: 'application/json',
            dataType: 'json',
            headers: { 'RequestVerificationToken': getCsrfToken() },
            data: JSON.stringify({ id: id }),
            success: function (d) {
                if (!d.success) {
                    alert(d.message);
                    return;
                }
                window.location.href = '/AlokasiAnggaran/History';
            },
            error: function () {
                alert('Gagal menghapus history.');
            }
        });
    }
</script>
}
