    var iconPickerTarget = null;

    function openIconPicker(inputId) {
        iconPickerTarget = inputId;
        var currentVal = $('#' + inputId).val();
        var $grid = $('#iconPickerGrid');
        $grid.empty();
        for (var i = 0; i < iconPickerIcons.length; i++) {
            var cls = iconPickerIcons[i];
            var sel = cls === currentVal ? ' selected' : '';
            $grid.append('<div class="icon-picker-item' + sel + '" data-icon="' + cls + '" title="' + cls + '" onclick="selectIcon(\'' + cls + '\')"><i class="' + cls + '"></i></div>');
        }
        $('#iconPickerSearch').val('');
        filterIconPicker('');
        $('#iconPickerModal').addClass('active show');
    }

    function closeIconPicker() {
        $('#iconPickerModal').removeClass('active show');
        iconPickerTarget = null;
    }

    function selectIcon(cls) {
        if (!iconPickerTarget) return;
        $('#' + iconPickerTarget).val(cls);
        var previewId = iconPickerTarget + 'Preview';
        var textId = iconPickerTarget + 'Text';
        $('#' + previewId).attr('class', cls);
        var $text = $('#' + textId);
        if ($text.length) {
            $text.text(cls);
        } else {
            $('#' + previewId).next('span').text(cls);
        }
        closeIconPicker();
    }

    function onIconSearchInput() {
        filterIconPicker($('#iconPickerSearch').val().toLowerCase());
    }

    function filterIconPicker(q) {
        $('#iconPickerGrid .icon-picker-item').each(function () {
            var icon = $(this).data('icon').toLowerCase();
            $(this).toggle(icon.indexOf(q) > -1);
        });
    }

    $(function () {
        initDataTables();
        loadAll();

        $(document).on('click', '.modal-overlay', function (e) {
            if (e.target === this) {
                resetModalForm(this.id);
                $(this).removeClass('active show');
            }
        });

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') {
                $('.modal-overlay.active, .modal-overlay.show').each(function () {
                    resetModalForm(this.id);
                    $(this).removeClass('active show');
                });
            }
        });
    });
