@section Scripts {
<script>
    var allRoles = [];
    var dtUsers, dtRoles, dtMenuRoles;

    // Cache Data Maps by ID for safe parameter handling
    var cachedUsers = {};
    var cachedRoles = {};
    var cachedMenuRoles = {};

    var getCsrf = function () {
        return $('meta[name="csrf-token"]').attr('content') || $('input[name="__RequestVerificationToken"]').val() || '';
    };

    // ATURAN DATATABLES: Wajib Bahasa Indonesia Penuh dan pagination bersimbol panah
    var dtLanguageConfig = {
        lengthMenu: "Tampilkan _MENU_ data per halaman",
        zeroRecords: "Data tidak ditemukan",
        info: "Menampilkan _START_ sampai _END_ dari _TOTAL_ total data",
        infoEmpty: "Menampilkan 0 sampai 0 dari 0 data",
        infoFiltered: "(difilter dari _MAX_ total data)",
        search: "Cari:",
        searchPlaceholder: "Ketik kata kunci...",
        paginate: {
            first: "«",
            last: "»",
            next: "›",
            previous: "‹"
        },
        processing: "Sedang memproses data...",
        loadingRecords: "Memuat data..."
    };

    function showAlert(type, message) {
        var icon = type === 'success' ? 'check-circle' : 'exclamation-circle';
        $('#dbAlertArea').html('<div class="alert alert-' + type + ' db-alert"><i class="fas fa-' + icon + '"></i> ' + message + '</div>');
        setTimeout(function () { $('#dbAlertArea .db-alert').fadeOut(300, function () { $(this).remove(); }); }, 4500);
    }

    // ATURAN REQUEST: Wajib struktur lengkap $.ajax() dengan header & body CSRF
    function ajaxPost(url, data, cb) {
        var t = getCsrf();
        $.ajax({
            url: url,
            type: 'POST',
            dataType: 'json',
            headers: { 'RequestVerificationToken': t },
            data: $.extend({}, data, { __RequestVerificationToken: t }),
            success: function (res) {
                if (res.success) {
                    if (typeof cb === 'function') cb();
                    showAlert('success', res.message);
                    loadAll();
                } else {
                    showAlert('danger', res.message || 'Terjadi kesalahan.');
                }
            },
            error: function (xhr) {
                var msg = 'Terjadi kesalahan server.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    msg = xhr.responseJSON.message;
                }
                showAlert('danger', msg);
            }
        });
    }

    function initDataTables() {
        dtUsers = $('#tableUsers').DataTable({
            pageLength: 10,
            lengthMenu: [
                [10, 25, 50, 100, -1],
                [10, 25, 50, 100, "Semua"]
            ],
            language: dtLanguageConfig,
            columns: [
                { data: null, render: function (d, t, r, m) { return m.row + 1; }, className: "text-center" },
                { data: 'namaLengkap', className: "db-td-bold" },
                { data: 'email' },
                { data: 'roleName', render: function (d) { return '<span class="db-badge db-badge-blue">' + (d || '-') + '</span>'; } },
                {
                    data: 'isActive',
                    render: function (d) {
                        return d ? '<span class="db-badge db-badge-green"><i class="fas fa-check"></i> Aktif</span>'
                                 : '<span class="db-badge db-badge-red"><i class="fas fa-times"></i> Nonaktif</span>';
                    }
                },
                { data: 'createdAt' },
                {
                    data: null,
                    orderable: false,
                    render: function (d, t, u) {
                        return '<div class="db-action-btns">' +
                            '<button type="button" class="db-btn-icon" onclick="openEditUser(' + u.id + ')"><i class="fas fa-pen"></i> Edit</button>' +
                            '<button type="button" class="db-btn-icon danger" onclick="confirmDelete(\'user\',' + u.id + ')"><i class="fas fa-trash"></i> Hapus</button>' +
                            '</div>';
                    }
                }
            ]
        });

        dtRoles = $('#tableRoles').DataTable({
            pageLength: 10,
            lengthMenu: [
                [10, 25, 50, 100, -1],
                [10, 25, 50, 100, "Semua"]
            ],
            language: dtLanguageConfig,
            columns: [
                { data: null, render: function (d, t, r, m) { return m.row + 1; }, className: "text-center" },
                { data: 'namaRole', className: "db-td-bold" },
                { data: 'deskripsi' },
                {
                    data: null,
                    orderable: false,
                    render: function (d, t, r) {
                        return '<div class="db-action-btns">' +
                            '<button type="button" class="db-btn-icon" onclick="openEditRole(' + r.id + ')"><i class="fas fa-pen"></i> Edit</button>' +
                            '<button type="button" class="db-btn-icon danger" onclick="confirmDelete(\'role\',' + r.id + ')"><i class="fas fa-trash"></i> Hapus</button>' +
                            '</div>';
                    }
                }
            ]
        });

        dtMenuRoles = $('#tableMenuRoles').DataTable({
            pageLength: 10,
            lengthMenu: [
                [10, 25, 50, 100, -1],
                [10, 25, 50, 100, "Semua"]
            ],
            language: dtLanguageConfig,
            columns: [
                { data: null, render: function (d, t, r, m) { return m.row + 1; }, className: "text-center" },
                { data: 'roleName', render: function(d) { return '<span class="db-badge db-badge-blue">' + (d || '-') + '</span>'; } },
                { data: 'namaMenu', className: "db-td-bold" },
                { data: 'icon', render: function (d) { return '<i class="' + (d || 'fas fa-circle') + '" style="color:var(--primary,#1e3a8a);margin-right:6px;"></i><code style="font-size:.75rem;color:var(--text-muted,#6b6b8d);">' + (d || '-') + '</code>'; } },
                { data: 'url', render: function (d) { return '<code style="font-size:.75rem;color:var(--teal,#0891b2);">' + d + '</code>'; } },
                { data: 'urutan', className: "text-center" },
                {
                    data: null,
                    orderable: false,
                    render: function (d, t, m) {
                        return '<div class="db-action-btns">' +
                            '<button type="button" class="db-btn-icon" onclick="openEditMenuRole(' + m.id + ')"><i class="fas fa-pen"></i> Edit</button>' +
                            '<button type="button" class="db-btn-icon danger" onclick="confirmDelete(\'menu\',' + m.id + ')"><i class="fas fa-trash"></i> Hapus</button>' +
                            '</div>';
                    }
                }
            ]
        });
    }

    // Tab navigation switcher
    function switchDbTab(tab, btn) {
        $('.db-tab-btn').removeClass('active');
        $(btn).addClass('active');

        if (tab === 'all') {
            $('#sectionUsers, #sectionRoles, #sectionMenuRoles').fadeIn(150);
            if (dtUsers) dtUsers.columns.adjust();
            if (dtRoles) dtRoles.columns.adjust();
            if (dtMenuRoles) dtMenuRoles.columns.adjust();
        } else if (tab === 'users') {
            $('#sectionUsers').fadeIn(150);
            $('#sectionRoles, #sectionMenuRoles').hide();
            if (dtUsers) dtUsers.columns.adjust().draw();
        } else if (tab === 'roles') {
            $('#sectionRoles').fadeIn(150);
            $('#sectionUsers, #sectionMenuRoles').hide();
            if (dtRoles) dtRoles.columns.adjust().draw();
        } else if (tab === 'menus') {
            $('#sectionMenuRoles').fadeIn(150);
            $('#sectionUsers, #sectionRoles').hide();
            if (dtMenuRoles) dtMenuRoles.columns.adjust().draw();
        }
    }

    // Request data via $.ajax()
    function loadAll() {
        $.ajax({
            url: '/Admin/GetUsers',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                cachedUsers = {};
                (data || []).forEach(function (u) { cachedUsers[u.id] = u; });
                $('#badgeUserCount').text(data ? data.length : 0);
                if (dtUsers) {
                    dtUsers.clear().rows.add(data || []).draw();
                }
            }
        });

        $.ajax({
            url: '/Admin/GetRoles',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                allRoles = data || [];
                cachedRoles = {};
                allRoles.forEach(function (r) { cachedRoles[r.id] = r; });
                $('#badgeRoleCount').text(allRoles.length);
                if (dtRoles) {
                    dtRoles.clear().rows.add(allRoles).draw();
                }
                populateSelects();
            }
        });

        $.ajax({
            url: '/Admin/GetMenuRoles',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                cachedMenuRoles = {};
                (data || []).forEach(function (m) { cachedMenuRoles[m.id] = m; });
                $('#badgeMenuCount').text(data ? data.length : 0);
                if (dtMenuRoles) {
                    dtMenuRoles.clear().rows.add(data || []).draw();
                }
            }
        });
    }

    function populateSelects() {
        var opts = '<option value="">-- Pilih Role --</option>';
        for (var i = 0; i < allRoles.length; i++) {
            opts += '<option value="' + allRoles[i].id + '">' + allRoles[i].namaRole + '</option>';
        }
        $('#createUserRole, #editUserRole, #createMenuRoleRoleId, #editMenuRoleRoleId').html(opts);
    }

    function resetModalForm(id) {
        var $m = $('#' + id);
        $m.find('form').each(function () { this.reset(); });
        $m.find('.form-control').removeClass('is-invalid is-valid');
    }

    function openModal(id) {
        $('#' + id).addClass('active show');
    }

    function closeModal(id) {
        resetModalForm(id);
        $('#' + id).removeClass('active show');
    }

    function openEditUser(id) {
        var u = cachedUsers[id];
        if (!u) return;
        $('#editUserId').val(u.id);
        $('#editUserName').val(u.namaLengkap);
        $('#editUserEmail').val(u.email);
        $('#editUserPassword').val('');
        $('#editUserRole').val(u.roleId);
        $('#editUserActive').val(u.isActive ? 'true' : 'false');
        openModal('modalEditUser');
    }

    function openEditRole(id) {
        var r = cachedRoles[id];
        if (!r) return;
        $('#editRoleId').val(r.id);
        $('#editRoleName').val(r.namaRole);
        $('#editRoleDesc').val(r.deskripsi === '-' ? '' : r.deskripsi);
        openModal('modalEditRole');
    }

    function openEditMenuRole(id) {
        var m = cachedMenuRoles[id];
        if (!m) return;
        $('#editMenuRoleId').val(m.id);
        $('#editMenuRoleRoleId').val(m.roleId);
        $('#editMenuRoleName').val(m.namaMenu);
        var iconVal = m.icon || 'fas fa-circle';
        $('#editMenuRoleIcon').val(m.icon || '');
        $('#editMenuRoleIconPreview').attr('class', iconVal);
        $('#editMenuRoleIconText').text(m.icon || '-');
        $('#editMenuRoleUrl').val(m.url);
        $('#editMenuRoleUrutan').val(m.urutan);
        openModal('modalEditMenuRole');
    }

    function confirmDelete(type, id) {
        var endpoint = '';
        var name = '';
        if (type === 'user') {
            var u = cachedUsers[id];
            if (!u) return;
            endpoint = '/Admin/DeleteUser/' + id;
            name = 'user "' + u.namaLengkap + '"';
        } else if (type === 'role') {
            var r = cachedRoles[id];
            if (!r) return;
            endpoint = '/Admin/DeleteRole/' + id;
            name = 'role "' + r.namaRole + '"';
        } else if (type === 'menu') {
            var m = cachedMenuRoles[id];
            if (!m) return;
            endpoint = '/Admin/DeleteMenuRole/' + id;
            name = 'menu "' + m.namaMenu + '"';
        }

        $('#deleteItemName').text(name);
        $('#btnConfirmDelete').off('click').on('click', function () {
            ajaxPost(endpoint, { id: id }, function () { closeModal('modalConfirmDelete'); });
        });
        openModal('modalConfirmDelete');
    }

    // Submit Handlers
    function submitCreateUser(e) {
        e.preventDefault();
        var d = {};
        $('#formCreateUser').serializeArray().forEach(function (f) { d[f.name] = f.value; });
        ajaxPost('/Admin/CreateUser', d, function () { closeModal('modalCreateUser'); });
