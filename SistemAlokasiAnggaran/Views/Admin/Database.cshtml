@{
    ViewData["Title"] = "Database";
}

<style>
    /* Tabs Navigation */
    .db-nav-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .db-tab-btn {
        padding: 8px 18px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid var(--border-color, #e2e8f0);
        color: var(--text-body, #334155);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.15s ease;
        font-family: inherit;
        box-shadow: var(--shadow-xs);
    }
    .db-tab-btn:hover {
        background: var(--primary-50, #eff6ff);
        color: var(--primary, #1e3a8a);
        border-color: var(--primary-border, #bfdbfe);
    }
    .db-tab-btn.active {
        background: var(--primary-50, #eff6ff);
        color: var(--primary, #1e3a8a);
        border-color: var(--primary-border, #bfdbfe);
        font-weight: 700;
    }
    .db-tab-badge {
        font-size: 0.72rem;
        padding: 2px 8px;
        border-radius: var(--radius-pill, 9999px);
        background: var(--bg-subtle, #f1f5f9);
        color: var(--text-muted, #64748b);
        font-weight: 700;
    }
    .db-tab-btn.active .db-tab-badge {
        background: #ffffff;
        color: var(--primary, #1e3a8a);
        border: 1px solid var(--primary-border, #bfdbfe);
    }

    /* DataTable Overrides */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 1rem;
    }
    .dataTables_wrapper .dataTables_length select {
        border-radius: 6px;
        padding: 6px 10px;
        border: 1.5px solid var(--border-color, #e2e8f0);
        outline: none;
        background: #ffffff;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_length select:focus {
        border-color: var(--primary, #1e3a8a);
        box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.12);
    }
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 6px;
        padding: 6px 12px;
        border: 1.5px solid var(--border-color, #e2e8f0);
        margin-left: 6px;
        outline: none;
        transition: all 0.15s;
        background: #ffffff;
        font-size: 0.85rem;
    }
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: var(--primary, #1e3a8a);
        box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.12);
    }
    .dataTables_wrapper .dataTables_info {
        font-size: 0.82rem;
        color: var(--text-muted, #64748b);
        padding-top: 0.85rem;
    }
    .dataTables_wrapper .dataTables_paginate {
        padding-top: 0.75rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 0.35rem 0.75rem !important;
        margin: 0 2px !important;
        border-radius: 6px !important;
        font-size: 0.85rem !important;
        border: 1px solid var(--border-color, #e2e8f0) !important;
        background: #ffffff !important;
        color: var(--text-body, #334155) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: var(--primary-50, #eff6ff) !important;
        color: var(--primary, #1e3a8a) !important;
        border-color: var(--primary-border, #bfdbfe) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--primary, #1e3a8a) !important;
        color: #ffffff !important;
        border-color: var(--primary, #1e3a8a) !important;
        box-shadow: 0 1px 2px rgba(30, 58, 138, 0.2) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        color: #cbd5e1 !important;
        border-color: #f1f3f8 !important;
        background: #f8f9fc !important;
    }
</style>

<div class="row">
    <div class="col-12">
        <div id="dbAlertArea"></div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <div class="db-nav-tabs">
            <button type="button" class="db-tab-btn active" onclick="switchDbTab('all', this)"><i class="fas fa-layer-group"></i> Semua Data</button>
            <button type="button" class="db-tab-btn" onclick="switchDbTab('users', this)"><i class="fas fa-users"></i> Users <span id="badgeUserCount" class="db-tab-badge">0</span></button>
            <button type="button" class="db-tab-btn" onclick="switchDbTab('roles', this)"><i class="fas fa-shield-alt"></i> Roles <span id="badgeRoleCount" class="db-tab-badge">0</span></button>
            <button type="button" class="db-tab-btn" onclick="switchDbTab('menus', this)"><i class="fas fa-bars"></i> Menu Roles <span id="badgeMenuCount" class="db-tab-badge">0</span></button>
        </div>
    </div>
</div>

<div class="row" id="sectionUsers">
    <div class="col-12">
        <div class="db-data-card">
            <div class="db-card-top">
                <h3 class="db-card-title"><i class="fas fa-users" style="color:var(--primary,#1e3a8a);"></i> Tabel Users</h3>
                <button type="button" class="db-btn-primary" onclick="openModal('modalCreateUser')"><i class="fas fa-plus"></i> Tambah User</button>
            </div>
            <div class="p-3">
                <table id="tableUsers" class="table table-striped table-hover db-table w-100">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:50px;">#</th>
                            <th>NAMA LENGKAP</th>
                            <th>EMAIL</th>
                            <th>ROLE</th>
                            <th>STATUS</th>
                            <th>DIBUAT</th>
                            <th class="text-end" style="width:140px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="usersBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row" id="sectionRoles">
    <div class="col-12">
        <div class="db-data-card">
            <div class="db-card-top">
                <h3 class="db-card-title"><i class="fas fa-shield-alt" style="color:var(--primary,#1e3a8a);"></i> Tabel Roles</h3>
                <button type="button" class="db-btn-primary" onclick="openModal('modalCreateRole')"><i class="fas fa-plus"></i> Tambah Role</button>
            </div>
            <div class="p-3">
                <table id="tableRoles" class="table table-striped table-hover db-table w-100">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:50px;">#</th>
                            <th>NAMA ROLE</th>
                            <th>DESKRIPSI</th>
                            <th class="text-end" style="width:140px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="rolesBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row" id="sectionMenuRoles">
    <div class="col-12">
        <div class="db-data-card">
            <div class="db-card-top">
                <h3 class="db-card-title"><i class="fas fa-bars" style="color:var(--primary,#1e3a8a);"></i> Tabel Menu Roles</h3>
                <button type="button" class="db-btn-primary" onclick="openModal('modalCreateMenuRole')"><i class="fas fa-plus"></i> Tambah Menu</button>
            </div>
            <div class="p-3">
                <table id="tableMenuRoles" class="table table-striped table-hover db-table w-100">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:50px;">#</th>
                            <th>ROLE</th>
                            <th>NAMA MENU</th>
                            <th>ICON</th>
                            <th>URL</th>
                            <th class="text-center">URUTAN</th>
                            <th class="text-end" style="width:140px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="menuRolesBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Modal Tambah User *@
<div id="modalCreateUser" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user-plus" style="color:var(--primary,#1e3a8a);margin-right:.45rem;"></i> Tambah User</h3>
            <button type="button" class="modal-close" onclick="closeModal('modalCreateUser')">&times;</button>
        </div>
        <form id="formCreateUser" onsubmit="submitCreateUser(event)">
            <div class="modal-body">
                <div class="form-group mb-3"><label class="form-label">Nama Lengkap</label><input type="text" name="NamaLengkap" id="cUserNama" class="form-control" required /></div>
                <div class="form-group mb-3"><label class="form-label">Email</label><input type="email" name="Email" id="cUserEmail" class="form-control" required /></div>
                <div class="form-group mb-3"><label class="form-label">Password</label><input type="password" name="PasswordHash" id="cUserPass" class="form-control" minlength="6" required /></div>
                <div class="form-group mb-3"><label class="form-label">Konfirmasi Password</label><input type="password" name="ConfirmPassword" id="cUserConf" class="form-control" minlength="6" required /></div>
                <div class="form-group mb-2"><label class="form-label">Role</label><select name="RoleId" id="createUserRole" class="form-control" required><option value="">-- Pilih Role --</option></select></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="db-btn-outline" onclick="closeModal('modalCreateUser')">Batal</button>
                <button type="submit" class="db-btn-primary"><i class="fas fa-save"></i> Simpan</button>
            </div>
        </form>
    </div>
</div>

