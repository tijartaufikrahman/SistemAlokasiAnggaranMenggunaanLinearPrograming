            <input type="hidden" name="Id" id="editUserId" />
            <div class="modal-body">
                <div class="form-group mb-3"><label class="form-label">Nama Lengkap</label><input type="text" name="NamaLengkap" id="editUserName" class="form-control" required /></div>
                <div class="form-group mb-3"><label class="form-label">Email</label><input type="email" name="Email" id="editUserEmail" class="form-control" required /></div>
                <div class="form-group mb-3"><label class="form-label">Password Baru (kosongkan jika tidak diubah)</label><input type="password" name="Password" id="editUserPassword" class="form-control" minlength="6" placeholder="Biarkan kosong jika tidak ingin mengganti password" /></div>
                <div class="form-group mb-3"><label class="form-label">Role</label><select name="RoleId" id="editUserRole" class="form-control" required><option value="">-- Pilih Role --</option></select></div>
                <div class="form-group mb-2"><label class="form-label">Status</label><select name="IsActive" id="editUserActive" class="form-control"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
            </div>
