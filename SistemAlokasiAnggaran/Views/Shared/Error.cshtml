@model SistemAlokasiAnggaran.Models.ErrorViewModel
@{
    ViewData["Title"] = "Terjadi Kesalahan";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kesalahan Sistem - FinAlok Platform</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #f8fafc;
        }
        .login-wrapper { width: 100%; max-width: 440px; position: relative; }
        .login-card {
            position: relative; z-index: 1; background: #ffffff; border-radius: 16px;
            box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
            padding: 40px 36px 36px; width: 100%; border: 1px solid #e2e8f0;
            text-align: center;
        }
        .brand-badge {
            display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px;
            background: #fef2f2; border: 1px solid #fecaca; border-radius: 20px;
            color: #ef4444; font-size: 11.5px; font-weight: 700; letter-spacing: 0.5px;
            text-transform: uppercase; margin-bottom: 16px;
        }
        .icon-wrap {
            width: 64px; height: 64px; background: #ef4444;
            border-radius: 16px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 18px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
        }
        .icon-wrap i { font-size: 28px; color: #fff; }
        h1 { font-size: 22px; color: #0f172a; font-weight: 800; margin-bottom: 8px; letter-spacing: -.02em; }
        p { color: #64748b; font-size: 13.5px; line-height: 1.6; margin-bottom: 12px; }
        .req-id {
            font-size: 11.5px; color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0;
            padding: 6px 12px; border-radius: 6px; margin: 12px 0; font-family: monospace; display: inline-block;
        }
        .btn-return {
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            width: 100%; margin-top: 16px; padding: 12px 24px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #fff; text-decoration: none; border-radius: 12px;
            font-weight: 600; font-size: 14px; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
            transition: all .25s ease; font-family: inherit;
        }
        .btn-return:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4); color: #fff; }
        .btn-return:active { transform: translateY(0); }
    </style>
</head>
<body>
    <!-- ATURAN STYLING: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-3 py-4 position-relative min-vh-100 d-flex align-items-center justify-content-center w-100">
        <div class="login-wrapper">
            <div class="login-card">
                <div class="brand-badge"><i class="fas fa-triangle-exclamation"></i> Kesalahan Sistem</div>
                <div class="icon-wrap"><i class="fas fa-exclamation-triangle"></i></div>
                <h1>Terjadi Kendala Teknis</h1>
                <p>Maaf, permintaan Anda tidak dapat diproses saat ini. Sistem telah mencatat aktivitas ini untuk penanganan lebih lanjut.</p>
                @if (Model?.ShowRequestId == true)
                {
                    <div class="req-id">Request ID: @Model.RequestId</div>
                }
                <a href="/" class="btn-return">
                    <i class="fas fa-home"></i> Kembali ke Halaman Utama
                </a>
            </div>
        </div>
    </div>
</body>
</html>
